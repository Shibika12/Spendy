<MudPaper Width="250px" Class="py-3 nav-menu-container" Elevation="2">
    <MudNavMenu>
        <MudNavLink Href="/home" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Dashboard</MudNavLink>
        <MudNavLink Href="/transactions" Icon="@Icons.Material.Filled.List" Match="NavLinkMatch.All">Transactions</MudNavLink>
        <MudNavLink Href="/addtransaction" Icon="@Icons.Material.Filled.AddCircle" Match="NavLinkMatch.All">Add Transactions</MudNavLink>
        <MudNavLink Href="/debts-tracker" Icon="@Icons.Material.Filled.MoneyOff" Match="NavLinkMatch.All">Debts</MudNavLink>

        @* Spacer to push the log-out link to the bottom *@
        <MudSpacer />

        @* Log Out Link at the bottom *@
        <MudNavLink Href="#" Icon="@Icons.Material.Filled.ExitToApp" Match="NavLinkMatch.All" @onclick="LogoutHandler">Log Out</MudNavLink>
    </MudNavMenu>
</MudPaper>

@code {
    [Parameter]
    public string Username { get; set; }
    [Parameter]
    public EventCallback LogoutHandler { get; set; }
}