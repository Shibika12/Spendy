@page "/transactions"
@using ShibikaKhatri22068731CW1.Model
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject IUserService UserService
@inject ITagService TagService
@inject ITransactionService TransactionService
@inject IJSRuntime JS

<div class="container mt-2">
<h3>Transactions</h3>
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Transactions</h6>
                <h3 class="card-title mb-0">@_transactionSummary.TotalTransactionCount</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Inflows</h6>
                <h3 class="card-title mb-0 text-success">@FormatAmount(_transactionSummary.TotalInflows)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Total Outflows</h6>
                <h3 class="card-title mb-0" style="color:darkred">@FormatAmount(_transactionSummary.TotalOutflows)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted">Balance</h6>
                <h3 class="card-title mb-0">@FormatAmount(_transactionSummary.Balance)</h3>
            </div>
        </div>
    </div>
</div>
<div class="compact-filter-container">
    <div class="filter-section">
        <div class="filter-row">
            <div class="filter-item">
                <label for="searchTitle">Title:</label>
                <input type="text" id="searchTitle" @bind="SearchTitle" class="compact-input" placeholder="Search title"/>
            </div>
            <div class="filter-item">
                <label for="filterTags">Tags:</label>
                <input type="text" id="filterTags" @bind="FilterTags" class="compact-input" placeholder="Filter tags"/>
            </div>
            <div class="filter-item">
                <label for="filterType">Type:</label>
                <select id="filterType" @bind="FilterType" class="compact-input">
                    <option value="">All</option>
                    <option value="Credit">Credit</option>
                    <option value="Debit">Debit</option>
                </select>
            </div>
            <div class="filter-item">
                <label for="startDate">Start:</label>
                <input type="date" id="startDate" @bind="StartDate" class="compact-input"/>
            </div>
            <div class="filter-item">
                <label for="endDate">End:</label>
                <input type="date" id="endDate" @bind="EndDate" class="compact-input"/>
            </div>
            <div class="filter-item buttons">
                <button @onclick="ApplyFiltersAndSearch" class="btn btn-primary btn-sm">Apply</button>
                <button @onclick="ClearFilters" class="btn btn-secondary btn-sm">Clear</button>
            </div>
        </div>
    </div>
    <div class="sort-container mt-4">
        <h3>Sorting</h3>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label for="sortDate">Sort by:</label>
                <select id="sortDate" @bind="SortBy" class="form-control">
                    <option value="Date">Date</option>
                </select>
            </div>
            <div class="form-group col-md-6">
                <label>Order:</label>
                <div class="d-flex align-items-center">
                    <div class="form-check mr-3">
                        <input type="radio" id="ascending" name="sortOrder" checked="@(IsAscending)"
                               @onchange="@(() => IsAscending = true)" class="form-check-input"/>
                        <label for="ascending" class="form-check-label">Ascending</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" id="descending" name="sortOrder" checked="@(!IsAscending)"
                               @onchange="@(() => IsAscending = false)" class="form-check-input"/>
                        <label for="descending" class="form-check-label">Descending</label>
                    </div>
                </div>
            </div>
        </div>
        <button @onclick="ApplySorting" class="btn btn-secondary btn-sm">Sort</button>
        <button @onclick="() => NavigateToAddPage()" class="btn btn-primary btn-sm">Add Transactions</button>
    </div>
</div>
<div class="table-container mt-4">
<table class="transactions-table table table-striped">
<thead>
<tr>
    <th>ID</th>
    <th>Title</th>
    <th>Amount</th>
    <th>Type</th>
    <th>Date</th>
    <th>Tags</th>
    <th>Note</th>
    <th>Actions</th>
</tr>
</thead>
<tbody>
<td colspan="8">No transactions available</td>


@foreach (var transaction in FilteredTransactions)
{
    <tr>
        <td>@transaction.TransactionId</td>
        <td>@transaction.Title</td>
        <td>@FormatAmount(transaction.Amount)</td>
        <td>
            @transaction.Type
        </td>
        <td>@transaction.Date</td>
        <td>
            @if (!string.IsNullOrEmpty(transaction.Tags))
            {
                <div class="tags-wrapper">
                    @foreach (var tag in transaction.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="tag-badge">@tag.Trim()</span>
                    }
                </div>
            }
        </td>
        <td>@transaction.Note</td>
        <td>
            <button @onclick="() => NavigateToEditPage(transaction.TransactionId)" class="btn btn-primary btn-sm">Edit</button>
            <button @onclick="() => DeleteTransaction(transaction.TransactionId)" class="btn btn-danger btn-sm">Delete</button>
        </td>
    </tr>
}

</tbody>
</table>
</div>
</div>