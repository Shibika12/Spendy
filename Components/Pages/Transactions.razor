@page "/transactions"
@using ShibikaKhatri22068731CW1.Model
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject IUserService UserService
@inject ITagService TagService
@inject ITransactionService TransactionService
@inject IJSRuntime JS

<!-- Page container -->
<div class="container-fluid p-4">
    <!-- Header section -->
    <div class="page-header">
        <h1 class="page-title">Transactions</h1>
        <div class="page-actions">
            <!-- Button to navigate to add transaction page -->
            <button @onclick="() => NavigateToAddPage()" class="btn btn-primary">
                ➕ Add Transaction
            </button>
            <!-- Button to export transactions to CSV -->
            <button @onclick="ExportToCsvAsync" class="btn btn-secondary">
                📊 Export CSV
            </button>
        </div>
    </div>

    <!-- Summary statistics grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Transactions</div>
            <div class="stat-value">@_transactionSummary.TotalTransactionCount</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Inflows</div>
            <!-- Styling applied conditionally based on the type -->
            <div class="stat-value inflow">@FormatAmount(_transactionSummary.TotalInflows)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Total Outflows</div>
            <div class="stat-value outflow">@FormatAmount(_transactionSummary.TotalOutflows)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Balance</div>
            <div class="stat-value">@FormatAmount(_transactionSummary.Balance)</div>
        </div>
    </div>

    <!-- Filters and sorting section -->
    <div class="filters-container">
        <!-- Filters subsection -->
        <div class="filter-section">
            <h2 class="section-title">Filters</h2>
            <div class="filters-row">
                <!-- Filter for transaction title -->
                <div class="filter-item">
                    <label for="searchTitle">Title</label>
                    <input type="text" id="searchTitle" class="filter-input"
                           placeholder="Search by title" @bind="SearchTitle" />
                </div>
                <!-- Filter for transaction type -->
                <div class="filter-item">
                    <label for="filterType">Type</label>
                    <select id="filterType" class="filter-input" @bind="FilterType">
                        <option value="">All Types</option>
                        <option value="Credit">Credit</option>
                        <option value="Debit">Debit</option>
                        <option value="Debt">Debt</option>
                    </select>
                </div>
                <!-- Filter for transaction tags -->
                <div class="filter-item">
                    <label for="filterTags">Tags</label>
                    <input type="text" id="filterTags" class="filter-input"
                           placeholder="Filter by tags" @bind="FilterTags" />
                </div>
                <!-- Filters for date range -->
                <div class="filter-item">
                    <label for="startDate">Start Date</label>
                    <input type="date" id="startDate" class="filter-input" @bind="StartDate" />
                </div>
                <div class="filter-item">
                    <label for="endDate">End Date</label>
                    <input type="date" id="endDate" class="filter-input" @bind="EndDate" />
                </div>
                <!-- Apply and clear filters buttons -->
                <div class="filter-item" style="flex: 0 0 auto;">
                    <button @onclick="ApplyFiltersAndSearch" class="btn btn-primary">Apply</button>
                    <button @onclick="ClearFilters" class="btn btn-outline-secondary">Clear</button>
                </div>
            </div>
        </div>

        <!-- Sorting subsection -->
        <div class="filter-section">
            <h2 class="section-title">Sort Options</h2>
            <div class="filters-row">
                <!-- Sort by field -->
                <div class="filter-item">
                    <label for="sortBy">Sort by</label>
                    <select id="sortBy" class="filter-input" @bind="SortBy">
                        <option value="Date">Date</option>
                    </select>
                </div>
                <!-- Sort order selection -->
                <div class="filter-item">
                    <div class="d-flex gap-3">
                        <!-- Radio button for ascending order -->
                        <div class="form-check">
                            <input type="radio" id="ascending" name="sortOrder" class="form-check-input"
                                   checked="@IsAscending" @onchange="@(() => IsAscending = true)" />
                            <label class="form-check-label" for="ascending">Ascending</label>
                        </div>
                        <!-- Radio button for descending order -->
                        <div class="form-check">
                            <input type="radio" id="descending" name="sortOrder" class="form-check-input"
                                   checked="@(!IsAscending)" @onchange="@(() => IsAscending = false)" />
                            <label class="form-check-label" for="descending">Descending</label>
                        </div>
                    </div>
                </div>
                <!-- Apply sorting button -->
                <div class="filter-item" style="flex: 0 0 auto;">
                    <button @onclick="ApplySorting" class="btn btn-secondary">Apply Sort</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions table -->
    <div class="transactions-table">
        <table class="table table-hover mb-0">
            <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Amount</th>
                <th>Type</th>
                <th>Date</th>
                <th>Tags</th>
                <th>Note</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            <!-- Display message if no transactions are found -->
            @if (!FilteredTransactions.Any())
            {
                <tr>
                    <td colspan="8" class="text-center py-4">
                        <div class="empty-state">
                            <div class="empty-state-icon">📊</div>
                            <h4>No transactions found</h4>
                            <p>Start by adding your first transaction!</p>
                        </div>
                    </td>
                </tr>
            }
            <!-- Display each transaction -->
            @foreach (var transaction in FilteredTransactions)
            {
                <tr>
                    <td>@transaction.TransactionId</td>
                    <td>@transaction.Title</td>
                    <!-- Conditional styling for transaction amount -->
                    <td class="@(transaction.Type.ToLower() == "debit" ? "text-danger" : "text-success")">
                        @FormatAmount(transaction.Amount)
                    </td>
                    <td>@transaction.Type</td>
                    <td>@transaction.Date.ToString()</td>
                    <td>
                        <!-- Display tags as badges -->
                        @if (!string.IsNullOrEmpty(transaction.Tags))
                        {
                            foreach (var tag in transaction.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="tag-badge">@tag.Trim()</span>
                            }
                        }
                    </td>
                    <td>@transaction.Note</td>
                    <td>
                        <!-- Action buttons for edit and delete -->
                        <button class="action-btn edit-btn" @onclick="() => NavigateToEditPage(transaction.TransactionId)">
                            ✏️
                        </button>
                        <button class="action-btn delete-btn" @onclick="() => DeleteTransaction(transaction.TransactionId)">
                            🗑️
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
