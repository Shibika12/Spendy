@page "/transactions"
@using ShibikaKhatri22068731CW1.Model
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject ITransactionService TransactionService
@inject IJSRuntime JS

<h3 class="page-heading">View All Transactions</h3>

<!-- Add Transaction Button -->
<div class="add-transaction-container">
    <button class="btn btn-success" @onclick="NavigateToAddPage">Add Transaction</button>
</div>

<div class="page-layout">
    <!-- Sorting Section -->
    <div class="sort-container">
        <h3>Sorting</h3>
        <div class="form-group">
            <label for="sortDate">Sort by:</label>
            <select id="sortDate" @bind="SortBy" class="form-control">
                <option value="Date">Date</option>
            </select>
        </div>
        <div class="form-group">
            <label>Order:</label>
            <div class="d-flex align-items-center">
                <div class="form-check mr-3">
                    <input type="radio" id="ascending" name="sortOrder" checked="@(IsAscending)" @onchange="@(() => IsAscending = true)" class="form-check-input" />
                    <label for="ascending" class="form-check-label">Ascending</label>
                </div>
                <div class="form-check">
                    <input type="radio" id="descending" name="sortOrder" checked="@(!IsAscending)" @onchange="@(() => IsAscending = false)" class="form-check-input" />
                    <label for="descending" class="form-check-label">Descending</label>
                </div>
            </div>
        </div>
        <button @onclick="ApplySorting" class="btn btn-primary mt-2">Sort</button>
    </div>

    <!-- Filters Section -->
    <div class="filter-container">
        <h3>Filters</h3>
        <div class="form-group">
            <label for="searchTitle">Search by Title:</label>
            <input type="text" id="searchTitle" @bind="SearchTitle" class="form-control" placeholder="Enter title" />
        </div>
        <div class="form-group">
            <label for="filterTags">Filter by Tags:</label>
            <input type="text" id="filterTags" @bind="FilterTags" class="form-control" placeholder="Enter tags" />
        </div>
        <div class="form-group">
            <label for="filterType">Filter by Type:</label>
            <select id="filterType" @bind="FilterType" class="form-control">
                <option value="">All</option>
                <option value="Credit">Credit</option>
                <option value="Debit">Debit</option>
            </select>
        </div>
        <div class="form-group">
            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate" @bind="StartDate" class="form-control" />
        </div>
        <div class="form-group">
            <label for="endDate">End Date:</label>
            <input type="date" id="endDate" @bind="EndDate" class="form-control" />
        </div>
        <div class="form-group d-flex justify-content-between">
            <button @onclick="ApplyFiltersAndSearch" class="btn btn-success">Apply Filters</button>
            <button @onclick="ClearFilters" class="btn btn-secondary">Clear Filters</button>
        </div>
    </div>
</div>

<!-- Table Section -->
<div class="table-container mt-4">
    <table class="transactions-table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Amount</th>
            <th>Type</th>
            <th>Date</th>
            <th>Tags</th>
            <th>Note</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @if (FilteredTransactions == null || FilteredTransactions.Count == 0)
        {
            <tr>
                <td colspan="7">No transactions available</td>
            </tr>
        }
        else
        {
            @foreach (var transaction in FilteredTransactions)
            {
                <tr>
                    <td>@transaction.Title</td>
                    <td>@transaction.Amount</td>
                    <td>@transaction.Type</td>
                    <td>@transaction.Date</td>
                    <td>@transaction.Tags</td>
                    <td>@transaction.Note</td>
                    <td>
                        <button @onclick="() => NavigateToEditPage(transaction.TransactionId)" class="btn btn-primary btn-sm">Edit</button>
                        <button @onclick="() => DeleteTransaction(transaction.TransactionId)" class="btn btn-danger btn-sm">Delete</button>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<style>
    /* Add Transaction Button */
    .add-transaction-container {
        text-align: right;
        margin-bottom: 20px;
    }

    .add-transaction-container button {
        font-size: 1rem;
        padding: 8px 16px;
    }

    /* Global styling */
    .page-heading {
        text-align: center;
        font-size: 2rem;
        font-weight: bold;
        color: #4A90E2;
        margin-bottom: 20px;
    }

    .page-layout {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .sort-container,
    .filter-container {
        flex: 1;
        padding: 20px;
        background-color: #F5F7FA;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .sort-container h3,
    .filter-container h3 {
        color: #34495E;
        font-size: 1.5rem;
        margin-bottom: 15px;
    }

    .table-container {
        margin-top: 40px;
        padding: 20px;
        background-color: #FFFFFF;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .transactions-table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, sans-serif;
    }

    .transactions-table th {
        background-color: #4A90E2;
        color: white;
        padding: 12px;
        text-align: left;
        font-size: 1rem;
    }

    .transactions-table td {
        padding: 10px;
        font-size: 0.95rem;
        text-align: left;
        border-bottom: 1px solid #E0E0E0;
    }

    .transactions-table tbody tr:nth-child(even) {
        background-color: #F9F9F9;
    }

    .transactions-table tbody tr:hover {
        background-color: #F2F6FC;
        cursor: pointer;
    }

    .transactions-table tbody td[colspan="7"] {
        text-align: center;
        font-size: 1.1rem;
        color: #888;
    }
</style>