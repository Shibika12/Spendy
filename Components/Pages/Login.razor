@page "/login"
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject IUserService UserService

<MudContainer Style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 100vh; background: linear-gradient(135deg, #e0c3fc, #8ec5fc);">
    <!-- Page Title -->
    <MudText Typo="Typo.h3" Style="margin-bottom: 20px; font-family: 'Arial', sans-serif; color: white; font-weight: bold;">
        Welcome to Spendy
    </MudText>

    <!-- Login Form -->
    <MudPaper Style="padding: 30px; width: 100%; max-width: 400px; box-shadow: 0 4px 8px rgba(0,0,0,0.2); border-radius: 10px; background-color: white;">
        <MudText Typo="Typo.h4" Style="text-align: center; margin-bottom: 20px; font-family: Arial, sans-serif; color: #333;">Log in to Your Account</MudText>

        <MudForm Model="@Users" @ref="form" Validation="true">
            <!-- Username Field -->
            <MudTextField T="string" Label="Username" Variant="Variant.Filled" @bind-Value="Users.Username"
                          For="@(() => Users.Username)" Required="true" RequiredError="Username is required."
                          Style="margin-bottom: 15px; width: 100%;" />

            <!-- Password Field -->
            <MudTextField T="string" Label="Password" Variant="Variant.Filled" InputType="InputType.Password"
                          @bind-Value="Users.Password" For="@(() => Users.Password)" Required="true"
                          RequiredError="Password is required." Style="margin-bottom: 15px; width: 100%;" />

            <!-- Preferred Currency Dropdown -->
            <MudSelect T="string" @bind-Value="Users.PreferredCurrency" Variant="Variant.Outlined" Label="Preferred Currency"
                       Style="margin-bottom: 15px; width: 100%;">
                <MudSelectItem Value="@("USD")" />
                <MudSelectItem Value="@("NRS")" />
            </MudSelect>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Style="margin-bottom: 15px;">
                    @ErrorMessage
                </MudAlert>
            }

            <!-- Login Button -->
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogin" Style="width: 100%; padding: 10px;">
                Login
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>
