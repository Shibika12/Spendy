@page "/debt-entry"
@using ShibikaKhatri22068731CW1.Services.Interface;
@inject NavigationManager Nav
@inject IDebtService DebtService
<h3>Add Debt</h3>
<div class="container mt-4">
    <EditForm Model="@debt" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group">
            <label for="sourceOfDebt">Source of Debt</label>
            <InputText id="sourceOfDebt" class="form-control" @bind-Value="debt.SourceOfDebt" />
        </div>
        <div class="form-group">
            <label for="amount">Amount</label>
            <InputNumber id="amount" class="form-control" @bind-Value="debt.Amount" />
        </div>
        <div class="form-group">
            <label for="dueDate">Due Date</label>
            <InputDate id="dueDate" class="form-control" @bind-Value="debt.DueDate" />
        </div>
        <button type="submit" class="btn btn-primary">Add Debt</button>
    </EditForm>
</div>