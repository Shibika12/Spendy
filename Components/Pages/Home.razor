@page "/home"
@using ShibikaKhatri22068731CW1.Model
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject IUserService UserService
@inject ITransactionService TransactionService

<MudContainer Style="margin-top: 50px; padding: 20px; background-color: #f9f9f9; border-radius: 8px;">
    <MudText Typo="Typo.h3" Style="color: #4CAF50; font-weight: bold;">Welcome, Shibika</MudText>
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" Class="mt-2">
            <MudText Typo="Typo.h6" Style="font-weight: bold;">Filter by Date Range</MudText>
            <MudDatePicker @bind-Date="startDate" Label="Start Date" />
        </MudItem>
        <MudItem xs="12" sm="6" Class="mt-2">
            <MudDatePicker @bind-Date="endDate" Label="End Date" />
        </MudItem>
        <MudItem xs="12" sm="12">
            <MudButton OnClick="FilterTransactions" Variant="Variant.Filled" Style="color: white; background-color: #333">Apply Filter</MudButton>
            <MudButton OnClick="ClearFilter" Variant="Variant.Filled" Style="margin-left: 10px; color: white; background-color: #333">Clear Filter</MudButton>
        </MudItem>
    </MudGrid>

    @* Charts Layout *@
    <MudGrid Style="margin-top: 30px;" Spacing="3">
        @* Line Chart *@
        <MudItem xs="12" md="6" lg="6">
            <MudPaper Elevation="2" Style="padding: 20px; height: 400px; background-color: #fff3e0;">
                <MudText Style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Line Chart</MudText>
                <MudChart ChartType="ChartType.Line" ChartSeries="@Series" @bind-SelectedIndex="Index" XAxisLabels="@XAxisLabels" Width="100%" Height="300px" ChartOptions="@Options" />
            </MudPaper>
        </MudItem>

        @* Bar Chart *@
        <MudItem xs="12" md="6" lg="6">
            <MudPaper Elevation="2" Style="padding: 20px; height: 400px; background-color: #ede7f6;">
                <MudText Style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Bar Chart</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@Series" @bind-SelectedIndex="Index" XAxisLabels="@XAxisLabels" Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Financial Summary Cards Layout *@
    <MudGrid Style="margin-top: 40px;" Spacing="3">
        @* Total Cash Inflows Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #e8f5e9;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Total Cash Inflows</MudText>
                <MudText Typo="Typo.h4" Style="color: #4caf50; font-weight: bold;">@FormatAmount(_totalInflows)</MudText>
            </MudPaper>
        </MudItem>

        @* Total Cash Outflows Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #ffebee;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Total Cash Outflows</MudText>
                <MudText Typo="Typo.h4" Style="color: #f44336; font-weight: bold;">@FormatAmount(_totalOutflows)</MudText>
            </MudPaper>
        </MudItem>

        @* Remaining Balance Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #e3f2fd;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Remaining Balance</MudText>
                <MudText Typo="Typo.h4" Style="color: #2196f3; font-weight: bold;">@FormatAmount(_balance)</MudText>
            </MudPaper>
        </MudItem>

        @* Remaining Debts Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #fffde7;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Remaining Debts</MudText>
                <MudText Typo="Typo.h4" Style="color: #ffeb3b; font-weight: bold;">@FormatAmount((decimal)_remainingDebt)</MudText>
            </MudPaper>
        </MudItem>

        @* Cleared Debts Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #e8f5e9;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Cleared Debts</MudText>
                <MudText Typo="Typo.h4" Style="color: #4caf50; font-weight: bold;">@FormatAmount((decimal)_totalClearedDebt)</MudText>
            </MudPaper>
        </MudItem>

        @* Total Debts Card *@
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="2" Style="padding: 20px; background-color: #ede7f6;">
                <MudText Typo="Typo.h6" Style="font-weight: bold;">Total Debts</MudText>
                <MudText Typo="Typo.h4" Style="color: #9e9e9e; font-weight: bold;">@FormatAmount((decimal)_totalDebt)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Tables Section *@
    <MudGrid Style="margin-top: 40px;" Spacing="3">
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Style="padding: 20px; height: 100%; background-color: #e8f5e9;">
                <MudText Typo="Typo.h6" Style="font-weight: bold; margin-bottom: 10px;">Top 5 Highest Transactions</MudText>
                <MudTable Items="@_elements.Take(5)" Hover="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date</MudTd>
                        <MudTd DataLabel="Amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Style="padding: 20px; height: 100%; background-color: #ffebee;">
                <MudText Typo="Typo.h6" Style="font-weight: bold; margin-bottom: 10px;">Top 5 Lowest Transactions</MudText>
                <MudTable Items="@_elements.Take(5)" Hover="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.Date</MudTd>
                        <MudTd DataLabel="Amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="2" Style="padding: 20px; height: 100%; background-color: #fffde7;">
                <MudText Typo="Typo.h6" Style="font-weight: bold; margin-bottom: 10px;">Pending Debts</MudText>
                <MudTable Items="@_elements.Take(5)" Hover="true">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@context.DueDate</MudTd>
                        <MudTd DataLabel="Amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No pending debts</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>


@code {

    private int Index = -1; //default value cannot be 0 -> first selectedindex is 0.

    // Define static data directly
    private IEnumerable<Transaction> _elements = Enumerable.Empty<Transaction>();
}