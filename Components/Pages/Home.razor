@page "/home"
@using ShibikaKhatri22068731CW1.Model
@using ShibikaKhatri22068731CW1.Services.Interface
@inject NavigationManager Nav
@inject IUserService UserService
@inject ITransactionService TransactionService

<MudContainer Style="margin-top: 50px; padding: 20px; background-color: #f9f9f9; border-radius: 8px;">
    <MudText Typo="Typo.h3" Style="color: #4CAF50; font-weight: bold;">Welcome, Shibika</MudText>
    <MudGrid Class="date-filter-container mb-4">
        <MudItem xs="12" Class="date-filter-header">
            <MudText Typo="Typo.h6" Class="date-filter-title">Filter by Date Range</MudText>
        </MudItem>
        <MudItem xs="12" Class="date-pickers-row">
            <div class="picker-group">
                <MudDatePicker @bind-Date="startDate"
                               Label="Start Date"
                               Class="custom-date-picker"
                               DisableToolbar="true" />
                <MudDatePicker @bind-Date="endDate"
                               Label="End Date"
                               Class="custom-date-picker"
                               DisableToolbar="true" />
            </div>
            <div class="button-group">
                <MudButton OnClick="FilterTransactions"
                           Variant="Variant.Filled"
                           Class="filter-button">
                    Apply Filter
                </MudButton>
                <MudButton OnClick="ClearFilter"
                           Variant="Variant.Filled"
                           Class="filter-button">
                    Clear Filter
                </MudButton>
            </div>
        </MudItem>
    </MudGrid>

    @* Charts Section *@
    <MudGrid Class="mb-4">
        <!-- Cashflow Trend -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="4" Class="pa-4"
                      Style="height: 500px; background-color: #f9f9f9; border-radius: 10px; border: 1px solid #ddd;">
                <MudText Typo="Typo.h6" Class="mb-2"
                         Style="font-weight: bold; color: #444;">Cashflow Trend</MudText>
                <MudChart Class="custom-line-chart" ChartType="ChartType.Line"
                          ChartSeries="@Series"
                          @bind-SelectedIndex="SelectedChartIndex"
                          XAxisLabels="@XAxisLabels"
                          Width="100%"
                          Height="350px"
                          Style="background-color: #e3f2fd; border-radius: 8px; padding: 10px;" />
            </MudPaper>
        </MudItem>
        <!-- Expenses Breakdown -->
        <MudItem xs="12" sm="6">
            <MudPaper Elevation="4" Class="pa-4"
                      Style="height: 500px; background-color: #f9f9f9; border-radius: 10px; border: 1px solid #ddd;">
                <MudText Typo="Typo.h6" Class="mb-2"
                         Style="font-weight: bold; color: #444;">Expenses Breakdown</MudText>
                <MudChart Class="custom-bar-chart" ChartType="ChartType.Bar"
                          ChartSeries="@Series"
                          @bind-SelectedIndex="SelectedChartIndex"
                          XAxisLabels="@XAxisLabels"
                          Width="100%"
                          Height="350px"
                          Style="background-color: #ffebee; border-radius: 8px; padding: 10px;" />
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Tables Section *@
    <MudGrid Class="dashboard-tables">
        @* Top 5 Highest Inflows *@
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="4" Class="custom-table-card">
                <div class="table-header">
                    <MudText Typo="Typo.h6">Top 5 Highest Inflows</MudText>
                </div>
                <MudTable Items="@TopInflows"
                          Class="custom-table"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_loading"
                          LoadingProgressColor="Color.Info">
                    <HeaderContent>
                        <MudTh Class="custom-header">Date</MudTh>
                        <MudTh Class="custom-header">Title</MudTh>
                        <MudTh Class="custom-header">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date" Class="custom-cell">@context.Date</MudTd>
                        <MudTd DataLabel="Title" Class="custom-cell">@context.Title</MudTd>
                        <MudTd DataLabel="Amount" Class="custom-cell inflow-amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        @* Top 5 Highest Outflows *@
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="4" Class="custom-table-card">
                <div class="table-header">
                    <MudText Typo="Typo.h6">Top 5 Highest Outflows</MudText>
                </div>
                <MudTable Items="@TopOutflows"
                          Class="custom-table"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_loading"
                          LoadingProgressColor="Color.Info">
                    <HeaderContent>
                        <MudTh Class="custom-header">Date</MudTh>
                        <MudTh Class="custom-header">Title</MudTh>
                        <MudTh Class="custom-header">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date" Class="custom-cell">@context.Date</MudTd>
                        <MudTd DataLabel="Title" Class="custom-cell">@context.Title</MudTd>
                        <MudTd DataLabel="Amount" Class="custom-cell outflow-amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
        @* Pending Debts Table *@
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="4" Class="custom-table-card">
                <div class="table-header">
                    <MudText Typo="Typo.h6">Pending Debts</MudText>
                </div>
                <MudTable Items="@PendingDebts"
                          Class="custom-table"
                          Hover="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_loading"
                          LoadingProgressColor="Color.Info">
                    <HeaderContent>
                        <MudTh Class="custom-header">Date</MudTh>
                        <MudTh Class="custom-header">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date" Class="custom-cell">@context.DueDate</MudTd>
                        <MudTd DataLabel="Amount" Class="custom-cell debt-amount">@FormatAmount(@context.Amount)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="no-records">
                            <MudText>No pending debts</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int SelectedChartIndex = 0; // Default selected index
}
